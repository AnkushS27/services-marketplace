# Services Marketplace Environment Variables Reference

# ==============================================================================
# Backend Configuration (apps/api/.env)
# ==============================================================================
# Database (Neon) - pooled connection for running app, direct for migrations
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# Auth
JWT_ACCESS_SECRET="replace-with-secure-random-jwt-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS="30"

# CORS / cookies
FRONTEND_URL="http://localhost:3000"
COOKIE_DOMAIN=""

# Mock payments
WEBHOOK_SECRET="replace-with-webhook-secret"

# Server Port & Node Environment
PORT=4000
NODE_ENV="development"

# ==============================================================================
# Frontend Configuration (apps/web/.env.local)
# ==============================================================================
NEXT_PUBLIC_API_URL="http://localhost:4000"
